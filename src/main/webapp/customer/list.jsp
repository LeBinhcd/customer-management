<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Danh sách khách hàng</title><style>body{font-family:Arial;margin:30px;background:#f8fafc}.box{background:white;padding:25px;max-width:900px;margin:auto;box-shadow:0 4px 12px #0002}table{width:100%;border-collapse:collapse}th,td{padding:12px;border-bottom:1px solid #ddd;text-align:left}th{background:#1b2a7a;color:white}a{margin-right:10px}</style></head><body><div class="box"><h1>Danh sách khách hàng</h1><a href="${pageContext.request.contextPath}/customers?action=create">Thêm khách hàng</a><table><tr><th>Họ tên</th><th>Email</th><th>Địa chỉ</th><th>Hành động</th></tr><c:forEach items="${customers}" var="customer"><tr><td><a href="${pageContext.request.contextPath}/customers?action=view&id=${customer.id}">${customer.name}</a></td><td>${customer.email}</td><td>${customer.address}</td><td><a href="${pageContext.request.contextPath}/customers?action=edit&id=${customer.id}">Sửa</a><a href="${pageContext.request.contextPath}/customers?action=delete&id=${customer.id}">Xóa</a></td></tr></c:forEach></table></div></body></html>
